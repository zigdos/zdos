#!/bin/sh
# sdl-config for ZDOS's partial SDL 1.2 (installed by
# ports/graphics/sdl12/build.sh): the flags for zdos-cc, which finds
# build/sdk-ports itself
here=$(cd "$(dirname "$0")/.." && pwd)
for a in "$@"; do
    case $a in
        --version) echo 1.2.15 ;;
        --prefix | --exec-prefix) echo "$here" ;;
        --cflags) echo "-I$here/include/SDL -D_GNU_SOURCE=1 -D_REENTRANT" ;;
        --libs | --static-libs) echo "-lSDL" ;;
        *) echo "usage: sdl-config [--version] [--prefix] [--exec-prefix] [--cflags] [--libs] [--static-libs]" >&2; exit 1 ;;
    esac
done
