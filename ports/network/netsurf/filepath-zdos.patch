+#ifdef __zdos__
+/* A drive's colon ("C:", "/C:") is part of a path, not a separator */
+static bool drive_colon(const char *start, const char *colon)
+{
+	if ((colon - start == 2) && (*start == '/' || *start == '\\'))
+		start++;
+	return (colon - start == 1) &&
+		(((*start | 0x20) >= 'a') && ((*start | 0x20) <= 'z'));
+}
+#endif
