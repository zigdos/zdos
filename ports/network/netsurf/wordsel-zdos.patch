+			 * bytes), else the one character */
+			if ((mouse & BROWSER_MOUSE_DOUBLE_CLICK) &&
+			    (mouse & BROWSER_MOUSE_CLICK_1)) {
+				const char *t = mas->text.box->text;
+				size_t n = mas->text.box->length;
+				size_t from = idx, to = idx;
+				#define WORD_BYTE(c) ((unsigned char)(c) >= 0x80 || \
+					ascii_is_alphanumerical(c) || (c) == '_')
+				while (from > 0 && WORD_BYTE(t[from - 1]))
+					from--;
+				while (to < n && WORD_BYTE(t[to]))
+					to++;
+				#undef WORD_BYTE
+				if (from == to && to < n)
+					to = utf8_next(t, n, to);
+				if (from < to) {
+					selection_clear(html->sel, true);
+					selection_set_position(html->sel,
+						mas->text.box->byte_offset + from,
+						mas->text.box->byte_offset + to);
+					done = true;
+				}
+			}
