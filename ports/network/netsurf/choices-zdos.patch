+	/* ZDOS: %HOME%\.netsurf searched first (each user's Choices),
+	 * as upstream's ${HOME}/.netsurf; not without HOME (it'd be
+	 * the drive's \.netsurf, everyone's) */
+	{
+		const char *shared = NETSURF_FB_RESPATH":"NETSURF_FB_FONTPATH;
+		const char *home = getenv("HOME");
+		char *path = NULL;
