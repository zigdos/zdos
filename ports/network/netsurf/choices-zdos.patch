+			size_t len = strlen(home) + strlen(shared) + 12;
+			path = malloc(len);
+			if (path != NULL)
+				snprintf(path, len, "%s\\.netsurf:%s", home, shared);
+		}
+		respaths = fb_init_resource_path(path != NULL ? path : shared);
+		free(path);
+	}
 
