+/* ZDOS: THE SELECTION, THE CLIPBOARD, WORDS */
+
+static bool sel_any(fbtk_widget_t *w)
+{
+	return w->u.text.sel_from < w->u.text.sel_to;
+}
+
+static void sel_none(fbtk_widget_t *w)
+{
+	w->u.text.sel_from = w->u.text.sel_to = 0;
+}
+
+/* The selected bytes go, the caret where they were */
+static void sel_delete(fbtk_widget_t *w)
+{
+	int from = w->u.text.sel_from, to = w->u.text.sel_to;
+	memmove(w->u.text.text + from, w->u.text.text + to, w->u.text.len - to);
+	w->u.text.len -= to - from;
+	w->u.text.text[w->u.text.len] = '\0';
+	w->u.text.idx = from;
+	sel_none(w);
+}
+
+/* Letters, digits, _ and any non-ASCII byte: a word's */
+static bool word_byte(unsigned char c)
+{
+	return c >= 0x80 || isalnum(c) || c == '_';
+}
+
+/* The word at a byte, or the one character there between words */
+static void sel_word(fbtk_widget_t *w, int at)
+{
+	const char *t = w->u.text.text;
+	int from = at, to = at;
+	while (from > 0 && word_byte(t[from - 1]))
+		from--;
+	while (to < w->u.text.len && word_byte(t[to]))
+		to++;
+	if (from == to && to < w->u.text.len)
+		to = utf8_next(t, w->u.text.len, to);
+	w->u.text.sel_from = from;
+	w->u.text.sel_to = to;
+	w->u.text.idx = to;
+}
+
+static void sel_copy(fbtk_widget_t *w)
+{
+	if (sel_any(w))
+		guit->clipboard->set(w->u.text.text + w->u.text.sel_from,
+				w->u.text.sel_to - w->u.text.sel_from, NULL, 0);
+}
+
+/* Bytes in at the caret, line breaks left out */
+static void insert_text(fbtk_widget_t *w, const char *s, size_t n)
+{
+	char *grown = realloc(w->u.text.text, w->u.text.len + n + 1);
+	size_t k = 0;
+	if (grown == NULL)
+		return;
+	w->u.text.text = grown;
+	memmove(grown + w->u.text.idx + n, grown + w->u.text.idx,
+			w->u.text.len - w->u.text.idx + 1);
+	for (size_t i = 0; i < n; i++)
+		if (s[i] != '\r' && s[i] != '\n')
+			grown[w->u.text.idx + k++] = s[i];
+	/* what was left out: the rest moves back */
+	memmove(grown + w->u.text.idx + k, grown + w->u.text.idx + n,
+			w->u.text.len - w->u.text.idx + 1);
+	w->u.text.idx += k;
+	w->u.text.len += k;
+}
