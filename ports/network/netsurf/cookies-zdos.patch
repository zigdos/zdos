+	/* ZDOS: no ~ to expand: the cookies in
+	 * %HOME%\.netsurf\Cookies (made if missing), without HOME
+	 * only in memory (a shared folder would show them to all) */
+	const char *home = getenv("HOME");
+	if (home != NULL && *home != '\0') {
+		char cookies[512];
+		snprintf(cookies, sizeof cookies, "%s\\.netsurf", home);
+		mkdir(cookies, 0755);
+		snprintf(cookies, sizeof cookies, "%s\\.netsurf\\Cookies", home);
+		nsoption_setnull_charp(cookie_file, strdup(cookies));
+		nsoption_setnull_charp(cookie_jar, strdup(cookies));
