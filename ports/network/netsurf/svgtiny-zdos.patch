+/* ZDOS: the first <svg> element at or below node, referenced */
+static dom_element *find_svg(dom_node *node)
+{
+	dom_node_type type;
+	dom_string *name;
+	dom_node *child, *next;
+	dom_element *found;
+
+	if (dom_node_get_node_type(node, &type) != DOM_NO_ERR)
+		return NULL;
+	if (type == DOM_ELEMENT_NODE &&
+			dom_node_get_node_name(node, &name) == DOM_NO_ERR &&
+			name != NULL) {
+		bool is_svg = dom_string_byte_length(name) == 3 &&
+			strncasecmp(dom_string_data(name), "svg", 3) == 0;
+		dom_string_unref(name);
+		if (is_svg)
+			return (dom_element *)dom_node_ref(node);
+	}
+	if (dom_node_get_first_child(node, &child) != DOM_NO_ERR)
+		return NULL;
+	while (child != NULL) {
+		found = find_svg(child);
+		if (found != NULL) {
+			dom_node_unref(child);
+			return found;
+		}
+		if (dom_node_get_next_sibling(child, &next) != DOM_NO_ERR)
+			next = NULL;
+		dom_node_unref(child);
+		child = next;
+	}
+	return NULL;
+}
