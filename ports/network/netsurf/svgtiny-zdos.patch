+	/* ZDOS: parsed as HTML, the <svg> element sits in <body> */
+	dom_element *root;
+	exc = dom_document_get_document_element(document, &root);
 	if (exc != DOM_NO_ERR) {
 		return svgtiny_LIBDOM_ERROR;
 	}
-        if (svg == NULL) {
-                /* no root element */
+	if (root == NULL) {
+		/* no root element */
 		return svgtiny_SVG_ERROR;
-        }
+	}
+	*svg = find_svg((dom_node *)root);
+	dom_node_unref(root);
+	if (*svg == NULL) {
+		return svgtiny_NOT_SVG;
+	}
 
 	/* ensure root element is <svg> */
 	exc = dom_node_get_node_name(*svg, &svg_name);
