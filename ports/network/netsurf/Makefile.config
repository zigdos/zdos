override NETSURF_USE_CURL := YES
override NETSURF_USE_OPENSSL := NO
override NETSURF_USE_JPEG := YES
override NETSURF_USE_JPEGXL := NO
override NETSURF_USE_PNG := YES
override NETSURF_USE_WEBP := YES
override NETSURF_USE_DUKTAPE := YES
override NETSURF_USE_BMP := YES
override NETSURF_USE_GIF := YES
override NETSURF_USE_NSSVG := NO
override NETSURF_USE_ROSPRITE := NO
override NETSURF_USE_NSPSL := YES
override NETSURF_USE_NSLOG := YES
override NETSURF_USE_UTF8PROC := YES
override NETSURF_FB_FONTLIB := internal
override NETSURF_FB_RESPATH := /C:/DATA/NETSURF
# The wheel: NO scrolls the page down as it turns toward you; YES is
# the other way ("natural"):
override NETSURF_ZDOS_NATURAL_SCROLL := NO
# The x86 (BIOS) build's CPU: i686 runs on any Pentium Pro and later;
# pentium4 adds SSE2, core2 SSSE3 (faster floating point, mostly in
# JavaScript; the program then needs that CPU):
override NETSURF_ZDOS_X86_CPU := pentium4
