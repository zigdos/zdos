override NETSURF_USE_CURL := YES
override NETSURF_USE_OPENSSL := NO
override NETSURF_USE_JPEG := YES
override NETSURF_USE_JPEGXL := NO
override NETSURF_USE_PNG := YES
override NETSURF_USE_WEBP := YES
override NETSURF_USE_DUKTAPE := YES
override NETSURF_USE_BMP := YES
override NETSURF_USE_GIF := YES
override NETSURF_USE_NSSVG := YES
override NETSURF_USE_ROSPRITE := NO
override NETSURF_USE_NSPSL := YES
override NETSURF_USE_NSLOG := YES
override NETSURF_USE_UTF8PROC := YES
# Text through FreeType (ports/libs/freetype) in \SYSTEM\TTF's fonts;
# Arimo and Tinos have the widths of Arial and Times New Roman:
override NETSURF_FB_FONTLIB := freetype
override NETSURF_FB_FONTPATH := /C:/SYSTEM/TTF
override NETSURF_FB_FONT_SANS_SERIF := Arimo-Regular.ttf
override NETSURF_FB_FONT_SANS_SERIF_BOLD := Arimo-Bold.ttf
override NETSURF_FB_FONT_SANS_SERIF_ITALIC := Arimo-Italic.ttf
override NETSURF_FB_FONT_SANS_SERIF_ITALIC_BOLD := Arimo-BoldItalic.ttf
override NETSURF_FB_FONT_SERIF := Tinos-Regular.ttf
override NETSURF_FB_FONT_SERIF_BOLD := Tinos-Bold.ttf
override NETSURF_FB_FONT_MONOSPACE := IBMPlexMono-Regular.ttf
override NETSURF_FB_FONT_MONOSPACE_BOLD := IBMPlexMono-Bold.ttf
override NETSURF_FB_FONT_CURSIVE := Lora-Italic.ttf
override NETSURF_FB_FONT_FANTASY := SpaceGrotesk-Bold.ttf
override NETSURF_FB_RESPATH := /C:/DATA/NETSURF
# The wheel: NO scrolls the page down as it turns toward you; YES is
# the other way ("natural"):
override NETSURF_ZDOS_NATURAL_SCROLL := NO
# The x86 (BIOS) build's CPU: i686 runs on any Pentium Pro and later;
# pentium4 adds SSE2, core2 SSSE3 (faster floating point, mostly in
# JavaScript; the program then needs that CPU):
override NETSURF_ZDOS_X86_CPU := pentium4
# The version for ZDOS: NetSurf's own, read from
# its desktop/version.c (zdos_dialogs.c sets it):
ZDOS_NS_VERSION := $(shell sed -n 's/.*netsurf_version_m[ai][jn]or = \([0-9]*\);.*/\1/p' \
	$(dir $(lastword $(MAKEFILE_LIST)))desktop/version.c)
CFLAGS += -DZDOS_NS_MAJOR=$(word 1,$(ZDOS_NS_VERSION)) -DZDOS_NS_MINOR=$(word 2,$(ZDOS_NS_VERSION))
