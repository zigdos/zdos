--- a/libnsfb/src/surface/Makefile
+++ b/libnsfb/src/surface/Makefile
@@ -1,7 +1,14 @@
 # Sources
 
 # Common surface code and heap based surface handler
-SURFACE_HANDLER_yes := surface.c ram.c
+SURFACE_HANDLER_yes := surface.c ram.c zdos.c
+
+# The zdos surface's wheel: NO scrolls the page down as the wheel
+# turns toward you, YES the other way (NETSURF_ZDOS_NATURAL_SCROLL
+# in netsurf's Makefile.config, passed on by build.sh):
+ifeq ($(ZDOS_NATURAL_SCROLL),YES)
+  CFLAGS := $(CFLAGS) -DZDOS_NATURAL_SCROLL
+endif
 
 # optional surface handlers
 SURFACE_HANDLER_$(NSFB_SDL_AVAILABLE) += sdl.c
