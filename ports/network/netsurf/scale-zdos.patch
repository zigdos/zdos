 /* netsurf framebuffer library handle */
 static nsfb_t *nsfb;
@@ -333,6 +334,26 @@
 		loc.x1 = loc.x0 + width;
 		loc.y1 = loc.y0 + height;
 
+		/* ZDOS: smaller than it is: an area-averaged copy */
+		nsfb_get_geometry(bm, &bmwidth, &bmheight, &bmformat);
+		if (width > 0 && height > 0 &&
+				(width < bmwidth || height < bmheight)) {
+			const uint32_t *scaled;
+			bool alpha = bmformat == NSFB_FMT_ABGR8888;
+			nsfb_get_buffer(bm, &bmptr, &bmstride);
+			scaled = zdos_scaled(bitmap, (const uint32_t *)bmptr,
+					bmwidth, bmheight, bmstride / 4,
+					width, height, alpha);
+			if (scaled != NULL) {
+				if (!nsfb_plot_bitmap(nsfb, &loc,
+						(const nsfb_colour_t *)scaled,
+						width, height, width, alpha)) {
+					return NSERROR_INVALID;
+				}
+				return NSERROR_OK;
+			}
+		}
+
 		if (!nsfb_plot_copy(bm, NULL, nsfb, &loc)) {
