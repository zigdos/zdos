+   the next one of the same file and options, which would otherwise read
+   the whole file and look the fonts up again. */
+static struct {
+    char *key;
+    ASS_Library *library;
+    ASS_Track *track;
+    ASS_Renderer *renderer;
+} kept;
+
+static void drop_kept(void)
+{
+    if (kept.track)
+        ass_free_track(kept.track);
+    if (kept.renderer)
+        ass_renderer_done(kept.renderer);
+    if (kept.library)
+        ass_library_done(kept.library);
+    av_freep(&kept.key);
+    kept.track = NULL;
+    kept.renderer = NULL;
+    kept.library = NULL;
+}
+
