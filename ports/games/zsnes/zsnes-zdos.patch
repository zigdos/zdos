@@ -47,6 +47,25 @@
 
 #define BIT(X) (1 << (X))
 
+#ifdef __zdos__
+#include <ctype.h>
+#include "zdos.h"
+/* ZDOS's drives as Windows gives them (bit 0 A:), for the drive list */
+static unsigned int GetLogicalDrives(void)
+{
+    char letters[27];
+    unsigned int bits = 0;
+    size_t n = zdos->drives->letters(letters, sizeof(letters));
+    for (size_t i = 0; i < n && i < sizeof(letters); i++) {
+        int c = toupper((unsigned char)letters[i]);
+        if (c >= 'A' && c <= 'Z') {
+            bits |= BIT(c - 'A');
+        }
+    }
+    return bits;
+}
+#endif
+
 enum vtype { UB,
