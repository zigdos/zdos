+
+// The version for ZDOS: 7-Zip's (7zVersion.h), expanded before
+// ZDOS_FILE_VERSION's #
+#define Z7_FILE_VERSION(a, b, c) ZDOS_FILE_VERSION(a, b, c, 0)
+#define Z7_FILE_VERSION_OF(a, b, c) Z7_FILE_VERSION(a, b, c)
+Z7_FILE_VERSION_OF(MY_VER_MAJOR, MY_VER_MINOR, MY_VER_BUILD);
+
+// ZDOS's paths for 7-Zip's POSIX ones: '\\' -> '/', and "C:/x"
+// -> "/C:/x", absolute (names stored from there, as on Windows).
+// In file arguments, @lists, -o, -w, and -i, -x, -ai, -ax after
+// their '!' or '@'; passwords and other switches as typed.
+static void ZdosPath(UString &s, unsigned from)
+{
+  for (unsigned i = from; i < s.Len(); i++)
+    if (s[i] == '\\')
+      s.ReplaceOneCharAtPos(i, '/');
+  const unsigned n = s.Len() - from;
+  if (n >= 2 && ((s[from] | 0x20) >= 'a' && (s[from] | 0x20) <= 'z') && s[from + 1] == ':'
+      && (n == 2 || s[from + 2] == '/'))
+  {
+    if (n == 2)
+      s += L'/';
+    s.Insert(from, L"/");
+  }
+}
+
+static void ZdosPaths(UStringVector &args)
+{
+  bool switches = true;
+  for (unsigned i = 1; i < args.Size(); i++)
+  {
+    UString &s = args[i];
+    if (switches && s.IsEqualTo("--"))
+      switches = false;
+    else if (switches && s.Len() > 1 && s[0] == '-')
+    {
+      const wchar_t c = (wchar_t)(s[1] | 0x20);
+      if (c == 'o' || c == 'w')
+        ZdosPath(s, 2);
+      else if (c == 'i' || c == 'x' || (c == 'a' && s.Len() > 2 && ((s[2] | 0x20) == 'i' || (s[2] | 0x20) == 'x')))
+      {
+        for (unsigned k = 2; k < s.Len(); k++)
+          if (s[k] == '!' || s[k] == '@')
+          {
+            ZdosPath(s, k + 1);
+            break;
+          }
+      }
+    }
+    else
+      ZdosPath(s, s.Len() > 0 && s[0] == '@' ? 1 : 0);
+  }
+}
+#endif
